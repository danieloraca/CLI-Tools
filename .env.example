# Copy this file to .env and replace both placeholder URLs with the base URLs
# for the same Gecko environment. Include any required API version path.

# Account API: login, profile selection, and claiming app tokens.
CLI_TOOLS_ACCOUNT_API_URL=https://account-api.example.test

# App API: browsing contacts and applying scenarios to a development profile.
CLI_TOOLS_APP_API_URL=https://app-api.example.test

# The CLI prompts for login credentials and stores tokens separately.
# Offline scenario generation does not require these URLs or a login.
